# Model. "mock" runs fully offline with a scripted model. No key needed.
MODEL_PROVIDER=mock
MOCK_MODEL_BEHAVIOR=competent   # competent | lenient | gullible | broken | silent | slow

# Switch to a real model later:
# MODEL_PROVIDER=anthropic
# MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

DB_PATH=triage.db
PORT=3000
# key:role:name, comma separated. Roles: operator | reviewer | auditor. Replace these before exposing the server.
API_KEYS=dev-operator:operator:dev-operator,dev-alice:reviewer:alice,dev-bob:reviewer:bob,dev-audit:auditor:audit

AGENT_MAX_STEPS=8
AGENT_TIMEOUT_MS=30000
PROPOSAL_TTL_MS=86400000
FOUR_EYES_THRESHOLD_USD=25000
LOG_LEVEL=info                  # silent | info | debug (debug prints trace spans)
# CLOCK_PIN=2026-11-10T03:00:00.000Z   # pins time so the seed data behaves the same every run

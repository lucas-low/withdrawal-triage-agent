{
  "name": "withdrawal-triage-agent",
  "module": "src/cli/index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "ai": "^7.0.166",
    "wallet-guard": "github:lucas-low/wallet-guard#fa5c73c",
    "zod": "^4.6.7"
  },
  "scripts": {
    "cli": "bun run src/cli/index.ts",
    "serve": "bun run src/cli/index.ts serve",
    "test": "bun test",
    "eval": "bun run evals/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test && bun run eval",
    "obs:up": "deploy/compose.sh up -d",
    "obs:down": "deploy/compose.sh down",
    "langfuse:up": "deploy/langfuse-up.sh",
    "langfuse:down": "deploy/compose.sh -p langfuse --env-file deploy/langfuse.env -f deploy/langfuse.compose.upstream.yaml -f deploy/langfuse.override.yaml down",
    "redteam": "bun run evals/redteam.ts",
    "data:ofac": "bun run scripts/fetch-ofac.ts",
    "docker:app": "deploy/compose.sh --profile app up -d --build app"
  },
  "bin": {
    "withdrawal-triage": "src/cli/index.ts"
  }
}
